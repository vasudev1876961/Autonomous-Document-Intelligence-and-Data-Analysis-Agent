# Environment Configuration
# LLM API configuration (optional - system falls back to deterministic rule-guided reasoning if no key is provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Storage & DB
SQLITE_DB_PATH=data/processed/agent_memory.db
VECTOR_STORE_DIR=data/processed/vector_store
REPORTS_OUTPUT_DIR=outputs/reports
CHARTS_OUTPUT_DIR=outputs/charts

# Agent Execution Limits
MAX_AGENT_ITERATIONS=15
EXECUTION_TIMEOUT_SECONDS=120
REQUIRE_HITL_FOR_DISCREPANCIES=true
